# Required. The server mints short-lived, session-scoped JWTs from this;
# the browser never sees the raw key. rk_... from
# https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Optional: bring your own LLM for live mode, where it keeps writing the next
# clip so the stream runs on its own. The key stays on the server. Leave these
# unset and the app is the manual "Continue this scene" flow.
#   anthropic  defaults to claude-haiku-5-5
#   openai     defaults to gpt-5.4-mini; with LLM_BASE_URL, any
#              OpenAI-compatible endpoint (a local server may need no key)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
